# sbes.erp – Backend Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# Firebase Admin SDK
# Option A: Path to your service account JSON file (download from Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual credentials (use this OR the path above, not both)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Firebase Web API Key (for device sign-in flow simulation)
FIREBASE_API_KEY=YOUR_WEB_API_KEY

# CORS – comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
